    if doctor_id:
        appointments = appointments.filter(doctor_id=doctor_id)

    # Statistics
    stats = {
        'total': appointments.count(),
        'upcoming': appointments.filter(
            date__gte=timezone.now().date(),
            status__in=['pending', 'confirmed']
        ).count(),
