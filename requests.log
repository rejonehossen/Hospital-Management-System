        'female': patients.filter(gender='F').count(),
        'avg_age': patients.aggregate(avg=Avg('age'))['avg'] or 0,
        'new_today': patients.filter(registration_date__date=timezone.now().date()).count(),
    }

    # Blood groups
    blood_groups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']

    # Pagination
