from django.core.management.base import BaseCommand
from django.contrib.auth.hashers import make_password
from faker import Faker
import random
from datetime import datetime, timedelta
from ...models import *

class Command(BaseCommand):
    help = 'Create sample data for development'

    def handle(self, *args, **options):
        fake = Faker()

        self.stdout.write(self.style.SUCCESS('Creating sample data...'))

        # Create departments
        departments_data = [
            ('Cardiology', 'Heart and cardiovascular diseases', 'fa-heart'),
            ('Neurology', 'Brain and nervous system disorders', 'fa-brain'),
            ('Orthopedics', 'Bones, joints, and muscles', 'fa-bone'),
            ('Pediatrics', 'Child healthcare', 'fa-baby'),
            ('Dermatology', 'Skin diseases and conditions', 'fa-allergies'),
            ('Ophthalmology', 'Eye care and vision', 'fa-eye'),
            ('ENT', 'Ear, nose, and throat diseases', 'fa-ear'),
            ('Dental', 'Oral healthcare', 'fa-tooth'),
            ('Gynecology', 'Women\'s reproductive health', 'fa-female'),
            ('General Medicine', 'General healthcare', 'fa-stethoscope'),
        ]

        departments = []
        for name, desc, icon in departments_data:
            dept, created = Department.objects.get_or_create(
                name=name,
                defaults={'description': desc, 'icon': icon}
            )
            departments.append(dept)
            if created:
                self.stdout.write(f'Created department: {name}')

        # Create admin user
        admin_user, admin_created = User.objects.get_or_create(
            username='admin',
            defaults={
                'email': 'admin@medicare.com',
                'first_name': 'System',
                'last_name': 'Administrator',
                'password': make_password('admin123'),
                'role': 'admin',
                'is_staff': True,
                'is_superuser': True,
                'is_verified': True,
            }
        )
        if admin_created:
            self.stdout.write('Created admin user')

        # Create sample doctors
        specialties = [
            'Cardiologist', 'Neurologist', 'Orthopedic Surgeon', 'Pediatrician',
            'Dermatologist', 'Ophthalmologist', 'ENT Specialist', 'Dentist',
            'Gynecologist', 'General Physician'
        ]

        qualifications = ['MD', 'MBBS', 'MS', 'MCh', 'DNB', 'FRCS']

        for i in range(20):
            first_name = fake.first_name()
            last_name = fake.last_name()
            username = f'doc{first_name.lower()}{i}'
            email = f'{username}@medicare.com'

            user, created = User.objects.get_or_create(
                username=username,
                defaults={
                    'email': email,
                    'first_name': first_name,
                    'last_name': last_name,
                    'password': make_password('doctor123'),
                    'role': 'doctor',
                    'phone': fake.phone_number()[:15],
                    'is_verified': True,
                }
            )

            if created:
                doctor = Doctor.objects.create(
                    user=user,
                    department=random.choice(departments),
                    qualification=f'{random.choice(qualifications)} in {random.choice(specialties)}',
                    specialization=random.choice(specialties),
                    experience=random.randint(5, 30),
                    consultation_fee=random.randint(500, 2000),
                    bio=fake.text(max_nb_chars=200),
                    license_number=f'MED{random.randint(100000, 999999)}',
                    is_available=random.choice([True, True, True, False]),  # 75% available
                    max_patients_per_day=random.randint(15, 25),
                    working_hours_start='09:00',
                    working_hours_end='17:00',
                )
                self.stdout.write(f'Created doctor: Dr. {first_name} {last_name}')

        # Create sample patients
        blood_groups = ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']

        for i in range(50):
            first_name = fake.first_name()
            last_name = fake.last_name()
            username = f'pat{first_name.lower()}{i}'
            email = f'{username}@example.com'

            user, created = User.objects.get_or_create(
                username=username,
                defaults={
                    'email': email,
                    'first_name': first_name,
                    'last_name': last_name,
                    'password': make_password('patient123'),
                    'role': 'patient',
                    'phone': fake.phone_number()[:15],
                    'address': fake.address(),
                    'date_of_birth': fake.date_of_birth(minimum_age=18, maximum_age=80),
                    'is_verified': True,
                }
            )

            if created:
                dob = user.date_of_birth
                today = datetime.now().date()
                age = today.year - dob.year - ((today.month, today.day) < (dob.month, dob.day))

                patient = Patient.objects.create(
                    user=user,
                    age=age,
                    gender=random.choice(['M', 'F']),
                    blood_group=random.choice(blood_groups),
                    height=random.uniform(150, 190),
                    weight=random.uniform(50, 100),
                    emergency_contact=fake.phone_number()[:15],
                    allergies=random.choice(['None', 'Penicillin', 'Dust', 'Peanuts', '']),
                    medical_history=random.choice([
                        'Hypertension', 'Diabetes', 'Asthma', 'None',
                        'Previous heart surgery', 'Migraine'
                    ]),
                    current_medications=random.choice(['None', 'Metformin 500mg', 'Amlodipine 5mg', '']),
                )
                self.stdout.write(f'Created patient: {first_name} {last_name}')

        # Create sample appointments
        doctors = Doctor.objects.all()
        patients = Patient.objects.all()

        status_choices = ['pending', 'confirmed', 'completed', 'cancelled']
        type_choices = ['in_person', 'telemedicine', 'follow_up']

        for i in range(100):
            doctor = random.choice(doctors)
            patient = random.choice(patients)

            # Random date within next 30 days or past 30 days
            days_offset = random.randint(-30, 30)
            appointment_date = datetime.now().date() + timedelta(days=days_offset)

            # Only create if date is valid (not in past for pending/confirmed)
            if days_offset < 0:
                status = random.choice(['completed', 'cancelled'])
            else:
                status = random.choice(['pending', 'confirmed'])

            # Generate random time during doctor's working hours
            hour = random.randint(9, 16)
            minute = random.choice([0, 30])
            appointment_time = f'{hour:02d}:{minute:02d}'

            appointment = Appointment.objects.create(
                patient=patient,
                doctor=doctor,
                date=appointment_date,
                time=appointment_time,
                reason=fake.text(max_nb_chars=100),
                symptoms=fake.text(max_nb_chars=200),
                status=status,
                appointment_type=random.choice(type_choices),
                is_urgent=random.choice([True, False, False, False]),
            )

            # Update patient's last visit if appointment is completed
            if status == 'completed':
                patient.last_visit = datetime.now()
                patient.save()

            self.stdout.write(f'Created appointment: {patient} with {doctor} on {appointment_date}')

        # Create sample prescriptions
        appointments = Appointment.objects.filter(status='completed')
        medicines = [
            'Amoxicillin 500mg', 'Paracetamol 500mg', 'Ibuprofen 400mg',
            'Cetirizine 10mg', 'Omeprazole 20mg', 'Metformin 500mg',
            'Atorvastatin 20mg', 'Levothyroxine 50mcg', 'Losartan 50mg',
            'Amlodipine 5mg', 'Metoprolol 50mg', 'Furosemide 40mg'
        ]

        for appointment in appointments[:30]:  # Prescriptions for 30 completed appointments
            for _ in range(random.randint(1, 3)):  # 1-3 medicines per prescription
                prescription = Prescription.objects.create(
                    appointment=appointment,
                    patient=appointment.patient,
                    doctor=appointment.doctor,
                    medicine_name=random.choice(medicines),
                    dosage=random.choice(['500mg', '250mg', '10mg', '20mg', '50mg']),
                    frequency=random.choice(['Once daily', 'Twice daily', 'Three times daily', 'As needed']),
                    duration=random.choice(['7 days', '14 days', '30 days', 'Continue']),
                    quantity=random.choice(['30 tablets', '60ml', '1 tube', '15 capsules']),
                    instructions=random.choice([
                        'Take after meals', 'Take on empty stomach', 'With plenty of water',
                        'Avoid alcohol', 'Take at bedtime'
                    ]),
                    advice=fake.text(max_nb_chars=200),
                    max_refills=random.randint(0, 3),
                    is_active=random.choice([True, False]),
                )
                self.stdout.write(f'Created prescription: {prescription.medicine_name} for {appointment.patient}')

        # Create sample bills
        completed_appointments = Appointment.objects.filter(status='completed')

        for appointment in completed_appointments[:20]:  # Bills for 20 completed appointments
            consultation_fee = appointment.doctor.consultation_fee
            medicine_charges = random.randint(0, 1000)
            test_charges = random.randint(0, 2000)
            other_charges = random.randint(0, 500)
            discount = random.randint(0, 200)
            tax_rate = 0.18  # 18% tax

            subtotal = consultation_fee + medicine_charges + test_charges + other_charges
            tax_amount = subtotal * tax_rate
            total_amount = subtotal + tax_amount - discount

            bill = Billing.objects.create(
                appointment=appointment,
                patient=appointment.patient,
                doctor=appointment.doctor,
                consultation_fee=consultation_fee,
                medicine_charges=medicine_charges,
                test_charges=test_charges,
                other_charges=other_charges,
                tax_amount=tax_amount,
                discount=discount,
                total_amount=total_amount,
                paid_amount=random.choice([total_amount, total_amount * 0.5, 0]),
                payment_status=random.choice(['pending', 'partial', 'paid']),
                payment_method=random.choice(['cash', 'card', 'online', 'insurance']),
                due_date=datetime.now().date() + timedelta(days=15),
            )
            self.stdout.write(f'Created bill: ${total_amount:.2f} for {appointment.patient}')

        self.stdout.write(self.style.SUCCESS('Sample data created successfully!'))

from django.conf import settings
from .models import Notification, HospitalSetting

def site_settings(request):
    """Add site settings to template context."""
    context = {
        'hospital_name': getattr(settings, 'HOSPITAL_NAME', 'MediCare Hospital'),
        'hospital_address': getattr(settings, 'HOSPITAL_ADDRESS', ''),
        'hospital_phone': getattr(settings, 'HOSPITAL_PHONE', ''),
        'hospital_email': getattr(settings, 'HOSPITAL_EMAIL', ''),
        'debug': settings.DEBUG,
    }

    # Add settings from database
    try:
        db_settings = HospitalSetting.objects.filter(is_active=True)
        for setting in db_settings:
            context[f'setting_{setting.key}'] = setting.value
    except:
        pass

    return context

def user_notifications(request):
    """Add user notifications to template context."""
    context = {}

    if request.user.is_authenticated:
        unread_count = Notification.objects.filter(
            user=request.user,
            is_read=False
        ).count()
        context['unread_notifications_count'] = unread_count

        # Recent notifications
        recent_notifications = Notification.objects.filter(
            user=request.user
        ).order_by('-created_at')[:5]
        context['recent_notifications'] = recent_notifications

    return context

def user_role_context(request):
    """Add user role information to template context."""
    context = {}

    if request.user.is_authenticated:
        context['user_role'] = request.user.role
        context['is_admin'] = request.user.role == 'admin'
        context['is_doctor'] = request.user.role == 'doctor'
        context['is_patient'] = request.user.role == 'patient'
        context['is_receptionist'] = request.user.role == 'receptionist'
        context['is_staff_user'] = request.user.role in ['admin', 'doctor', 'receptionist']

    return context

from django.contrib.auth.decorators import user_passes_test
from django.contrib import messages
from django.shortcuts import redirect

def admin_required(function=None, login_url='login'):
    """
    Decorator for views that checks if the user is an admin,
    redirecting to the login page if necessary.
    """
    actual_decorator = user_passes_test(
        lambda u: u.is_authenticated and u.role == 'admin',
        login_url=login_url
    )
    if function:
        return actual_decorator(function)
    return actual_decorator

def doctor_required(function=None, login_url='login'):
    """
    Decorator for views that checks if the user is a doctor,
    redirecting to the login page if necessary.
    """
    actual_decorator = user_passes_test(
        lambda u: u.is_authenticated and u.role == 'doctor',
        login_url=login_url
    )
    if function:
        return actual_decorator(function)
    return actual_decorator

